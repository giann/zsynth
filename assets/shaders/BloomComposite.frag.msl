#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_BloomParams
{
    float Threshold;
    float Intensity;
    float2 TexelSize;
    float2 Direction;
    uint2 Padding;
};

struct main0_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct main0_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant type_BloomParams& BloomParams [[buffer(0)]], texture2d<float> Scene [[texture(0)]], texture2d<float> Bloom [[texture(1)]], sampler SceneSampler [[sampler(0)]], sampler BloomSampler [[sampler(1)]])
{
    main0_out out = {};
    float4 _39 = Scene.sample(SceneSampler, in.in_var_TEXCOORD0);
    out.out_var_SV_Target0 = float4(fast::clamp(_39.xyz + (Bloom.sample(BloomSampler, in.in_var_TEXCOORD0).xyz * BloomParams.Intensity), float3(0.0), float3(1.0)), _39.w);
    return out;
}


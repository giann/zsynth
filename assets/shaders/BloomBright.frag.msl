#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_BloomParams
{
    float Threshold;
    float Intensity;
    float2 TexelSize;
    float2 Direction;
    uint2 Padding;
};

struct main0_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct main0_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant type_BloomParams& BloomParams [[buffer(0)]], texture2d<float> Texture [[texture(0)]], sampler Sampler [[sampler(0)]])
{
    main0_out out = {};
    float4 _36 = Texture.sample(Sampler, in.in_var_TEXCOORD0);
    float _48 = fast::clamp((precise::max(_36.x, precise::max(_36.y, _36.z)) - BloomParams.Threshold) / precise::max(1.0 - BloomParams.Threshold, 9.9999997473787516355514526367188e-05), 0.0, 1.0);
    out.out_var_SV_Target0 = float4(_36.xyz * _48, _48);
    return out;
}

